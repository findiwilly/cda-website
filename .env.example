# ============================================================================
# CDA Website — environment variables
#
# Copy to `.env.local` for development:   cp .env.example .env.local
# Add the same keys as Project/Environment variables in Vercel.
#
# EVERYTHING HERE IS OPTIONAL. The site builds and runs with no configuration at
# all: database reads degrade to empty results, so the public site renders its
# static content and the admin panel reports that it is not configured. That is
# deliberate — it is what lets a pull request from a fork run a production build
# without access to secrets, and it means a missing variable breaks one feature
# rather than the whole deployment.
#
# Fill them in to switch each feature on. See docs/00-environment.md.
# ============================================================================


# ----------------------------------------------------------------------------
# Site URL
# ----------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang, the
# sitemap, robots.txt and schema.org `image` — schema.org needs a stable absolute
# URL, which is why the OG image is served from a fixed /api/og path rather than
# the file convention.
#
# If omitted, falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then
# http://localhost:3000.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.cameroondigital.agency


# ----------------------------------------------------------------------------
# MongoDB — blog posts, testimonials, FAQs, leads, admin accounts
# ----------------------------------------------------------------------------
# Without this: /blog, /testimonials and /faq render empty states, and every
# admin write returns 503 notConfigured.
# ----------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=cda


# ----------------------------------------------------------------------------
# Session signing secret — REQUIRED before the admin panel will accept a login
# ----------------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating this logs out every active admin session. Never commit the real value.
# ----------------------------------------------------------------------------
SESSION_SECRET=


# ----------------------------------------------------------------------------
# Cloudinary — blog cover images
# ----------------------------------------------------------------------------
# Admin uploads go browser → Cloudinary directly via a signature from
# /api/admin/upload/signature, so image bytes never pass through a Server Action.
# Uploads are refused without these; everything else keeps working.
#
# Add your Cloudinary hostname to next.config images.remotePatterns if you
# restrict it (the site currently serves these URLs via plain <img>, because the
# delivery URL is already transformed).
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ----------------------------------------------------------------------------
# SMTP — notifications
# ----------------------------------------------------------------------------
# Used to email CDA when a lead or a testimonial arrives. Without it, messages
# are logged to the server console instead of sent — visible in Vercel logs.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cameroon Digital Agency <no-reply@cameroondigital.agency>
# Where notifications are delivered. Defaults to SMTP_USER if unset.
SMTP_NOTIFY_TO=


# ----------------------------------------------------------------------------
# Admin account
# ----------------------------------------------------------------------------
# The email used to create the first admin account via `npm run seed`, and the
# address shown in admin UI copy.
# ----------------------------------------------------------------------------
ADMIN_EMAIL=hello@cameroondigital.agency

# ----------------------------------------------------------------------------
# Seed script only (never set in Vercel)
# ----------------------------------------------------------------------------
# Read by scripts/seed.ts, not by the app. Password must be 12+ characters.
#   ADMIN_EMAIL=... ADMIN_PASSWORD='...' npm run seed
# ----------------------------------------------------------------------------
# ADMIN_PASSWORD=